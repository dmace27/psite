---
/**
 * The real Schwabacher's Landing photograph, with the sky removed to alpha.
 * Transparency lets the skyline meet the page canvas in either theme; opacity
 * belongs in CSS so the original landscape detail stays intact in the asset.
 */
---
<figure class="hiking-scene">
  <div class="landscape-image">
  <img
    src="/images/schwabachers-landing-sunrise.png"
    alt="A wide sunrise panorama of the Grand Tetons, with golden peaks reflected in the river at Schwabacher’s Landing."
    width="1836"
    height="856"
    loading="lazy"
    decoding="async"
  />
  </div>
  <figcaption>
    <a href="https://seanhoyt.com/blogs/journal/teton-mountains-from-schwabacher-landing" target="_blank" rel="noopener noreferrer">Tetons at sunrise · photo by Sean Hoyt ↗</a>
  </figcaption>
</figure>

<style>
  /* Keep attribution in document flow so it cannot collide with footer links. */
  .hiking-scene { margin: 0; }
  /* Match the reference's shallow, viewport-anchored landscape band. */
  .landscape-image {
    position: fixed;
    inset: auto 0 0;
    width: 100vw;
    margin: 0;
    height: 31vh;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Crop excess sky and river to frame the peaks within the shallow band. */
    object-position: center 28%;
    opacity: .5;
    /* Soften the skyline while retaining the existing half-opacity treatment. */
    mask-image: linear-gradient(to bottom, transparent, rgb(0 0 0 / .45) 28%, #000 80%);
  }
  figcaption {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: .35rem 1rem;
    padding: .25rem 0 1.25rem;
    color: var(--ink);
    font-size: .625rem;
    opacity: .7;
  }
  a { color: inherit; pointer-events: auto; }
  @media (max-width: 640px) {
    img { object-position: 38% 28%; }
    figcaption { justify-content: flex-start; padding-top: .5rem; }
  }
  @media print { .hiking-scene { display: none; } }
</style>
