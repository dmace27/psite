---
interface Props { name: string }
const { name } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { label: 'Projects', href: '/projects' },
  { label: 'Writing', href: '/writing' },
  { label: 'Hobbies', href: '/hobbies' },
  { label: 'Other', href: '/other' },
  { label: 'Contact', href: '/contact' },
];

function activeLink(href: string) {
  if (path === href) return 'page';
  if (path.startsWith(`${href}/`)) return 'true';
  // The two collections are reached through Other.
  if (href === '/other' && ['/media', '/quotes'].includes(path)) return 'true';
  return undefined;
}
---
<header class="folio-header">
  <a class="folio-wordmark" href="/" aria-label={`${name}, home`}>DM</a>
  <nav aria-label="Main navigation">
    {links.map(({ label, href }) => <a href={href} aria-current={activeLink(href)}>{label}</a>)}
  </nav>
</header>
