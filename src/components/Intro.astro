---
import type { SiteContent } from '../content/schema';
import RichText from './RichText.astro';
import TextLink from './TextLink.astro';
interface Props { identity: SiteContent['identity']; headingLevel?: 'h1' | 'h3'; largeHeading?: boolean; }
// A gallery specimen uses h3; the actual page introduction defaults to h1.
const { identity, headingLevel: Heading = 'h1', largeHeading = false } = Astro.props;
---
<header class="intro">
  <Heading class:list={['intro-title', largeHeading && 'intro-title-large']}>{identity.name}</Heading>
  {identity.introduction.map((spans) => <p><RichText spans={spans} /></p>)}
  {identity.links.length > 0 && <div class="link-group">{identity.links.map((link) => <TextLink {...link} arrow />)}</div>}
</header>
