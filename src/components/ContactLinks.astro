---
import type { ContactMethod } from '../content/contact';
interface Props { methods: ContactMethod[]; compactEmail?: boolean; }
const { methods, compactEmail = false } = Astro.props;
---
<nav class="footer-contact-links" aria-label="Contact links">
  {methods.map((method) => (
    <a href={method.href} aria-label={method.pending ? `${method.label} — contact details to come` : compactEmail && method.id === 'email' ? `Email ${method.label}` : undefined}>
      {compactEmail && method.id === 'email' ? 'email' : method.label}
    </a>
  ))}
</nav>
