---
import type { CollectionEntry } from 'astro:content';
import { formatArticleDate } from '../lib/writing';
interface Props { articles: CollectionEntry<'writing'>[]; }
const { articles } = Astro.props;
---
<ul class="article-list" role="list">
  {articles.map((article) => <li>
    <article>
      <div class="article-list-top">
        <h2><a href={`/writing/${article.id}`}>{article.data.title}</a></h2>
        {article.data.publishedAt && <time class="meta" datetime={article.data.publishedAt}>{formatArticleDate(article.data.publishedAt)}</time>}
      </div>
      <p class="muted">{article.data.description}</p>
      {article.data.placeholder && <span class="meta">placeholder article</span>}
    </article>
  </li>)}
</ul>
