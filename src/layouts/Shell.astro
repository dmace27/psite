---
import '../styles/global.css';
interface Props { title: string; description: string; canonical?: string; }
const { title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // Run before paint to avoid a light flash when a dark preference is saved.
      (() => {
        let theme;
        try { theme = localStorage.getItem('personal-site-theme'); } catch { /* Storage is optional. */ }
        document.documentElement.dataset.theme = theme === 'dark' || theme === 'light'
          ? theme : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell"><slot /></div>
  </body>
</html>
