---
import Shell from './Shell.astro';
import Navigation from '../components/Navigation.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { siteContent } from '../content/site';
import '../styles/folio.css';
import '../styles/folio-interior.css';

interface Props { title: string; description?: string }
const { title, description = siteContent.metadata.description } = Astro.props;
const name = siteContent.identity.name.trim();
---
<Shell title={title} description={description}>
  <div class="folio folio-interior">
    <div class="folio-wrap">
      <Navigation name={name} />
      <main id="main"><slot /></main>
      <footer class="folio-footer">
        <span>{name}</span>
        <ContactLinks />
        <a class="folio-back-to-top" href="#main">Back to top ↑</a>
      </footer>
    </div>
  </div>
</Shell>
