---
import SiteLayout from '../layouts/SiteLayout.astro';
import Intro from '../components/Intro.astro';
import SectionRenderer from '../components/SectionRenderer.astro';
import { siteContent } from '../content/site';
---
<SiteLayout title={`${siteContent.identity.name} / home`}>
  <Intro identity={siteContent.identity} />
  <span class="meta">layout preview / content to come</span>
  <SectionRenderer sections={siteContent.sections} />
  <div class="home-explore"><a href="/projects">projects ↗</a><a href="/writing">writing ↗</a><a href="/hobbies">hobbies ↗</a><a href="/media">media ↗</a><a href="/quotes">quotes ↗</a></div>
</SiteLayout>
